{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "greenwheels": {
        "type": "local",
        "command": [".venv/Scripts/python.exe", "-m", "greenwheels_mcp"],
        "cwd": "mcp-server",
        "environment": {
          "GREENWHEELS_API_URL": "http://localhost:8000"
        },
        "codemode": false
      },
      "greenwheels-docker": {
        "type": "local",
        "command": [
          "docker",
          "compose",
          "-f",
          "docker-compose.yml",
          "--profile",
          "mcp",
          "run",
          "--rm",
          "-i",
          "mcp"
        ],
        "cwd": "c:\\code\\greenwheels",
        "codemode": false
      }
    }
  }
}
