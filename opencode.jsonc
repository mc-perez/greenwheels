{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "greenwheels-docker": {
        "type": "local",
        "command": [
          "docker",
          "compose",
          "--project-directory", "/code/greenwheels",
          "-f", "/code/greenwheels/docker-compose.yml",
          "--profile", "mcp",
          "run", "--rm", "-i",
          "mcp"
        ],
        "cwd": "/code/greenwheels",
        "codemode": false
      }
    }
  }
}
