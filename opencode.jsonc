{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "greenwheels": {
        "type": "local",
        "command": [
          "c:\\code\\greenwheels\\mcp-server\\.venv\\Scripts\\python.exe",
          "-m",
          "greenwheels_mcp"
        ],
        "cwd": "c:\\code\\greenwheels\\mcp-server",
        "environment": {
          "GREENWHEELS_API_URL": "http://localhost:8000"
        },
        "codemode": false
      }
    }
  }
}
